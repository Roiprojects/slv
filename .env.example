# ==============================================================================
# SLV Borewells - Environment Configuration
# ==============================================================================

# Server & Preview Network Configuration
# (Port numbers and hosts MUST only be managed via .env)
PORT=5173
PREVIEW_PORT=4173
HOST=true

# Allowed Hosts for Host Header Validation
# (Prevents "Blocked request. This host is not allowed" errors)
# Use 'true' to allow all hosts, or provide comma-separated domains:
# e.g., ALLOWED_HOSTS=slvborewells.com,www.slvborewells.com,localhost
ALLOWED_HOSTS=true

# Backend API Proxy Configuration (if proxying API requests)
# Managed strictly via .env
# PROXY_PORT=5000
# PROXY_TARGET=http://localhost:5000

